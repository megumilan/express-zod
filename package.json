        "@types/supertest": "^7.2.1",
        "@vitest/ui": "^5.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.0",
        "supertest": "^7.2.2",
        "tsdown": "^0.23.0",
        "tsx": "^4.23.13",
        "type-fest": "^5.9.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0",
        "zod": "^4.5.4"
    },
    "packageManager": "pnpm@10.34.4",
    "engines": {
        "node": ">=24.12.0"
    }
