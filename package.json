    "type": "module",
    "main": "index.js",
    "scripts": {
        "format": "biome check --write .",
        "lint": "biome lint .",
        "prepare": "husky",
        "test": "vitest"
    },
    "lint-staged": {
        "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
