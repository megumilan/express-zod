{
    "name": "@express-zod/client",
    "version": "0.0.1-alpha.1",
    "description": "Type-safe API client for ExpressZod",
    "keywords": [
        "express",
        "zod",
        "client"
    ],
    "license": "MIT",
    "author": "megumilan",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsdown"
    },
    "dependencies": {
        "type-fest": "catalog:"
    },
    "devDependencies": {
        "express-zod": "workspace:*"
    },
    "peerDependencies": {
        "express-zod": "*"
    },
    "packageManager": "pnpm@10.34.4",
    "publishConfig": {
        "access": "public"
    }
}
