{
    "extends": "../../tsconfig.base.json",
    "include": ["src"],
    "exclude": ["node_modules", "dist"],
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "exactOptionalPropertyTypes": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "types": ["@express-zod/openapi"]
    }
}
